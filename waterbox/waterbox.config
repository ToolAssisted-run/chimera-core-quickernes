{
	"coreName": "quickerNES",
	"author": "Sergio Martin (quickNES: kode54, blargg)",
	"version": "1.0.0",
	"url": "https://github.com/ToolAssisted-run/quickerNES",
	"systemId": "NES",
	"systemNames": { "NES": "Nintendo Entertainment System" },
	"romFile": "rom",
	"deterministic": true,
	"memoryLayoutMiB": [ 16, 16, 4, 16, 16 ],
	"_memoryLayoutMiB_note": "sbrk, sealed, invis, plain, mmap. Every savestate costs work proportional to the DECLARED layout, not to what the core uses: the host tracks page state for the whole arena. 272MB made a per-frame save+load cost 4.8ms for an NES; 68MB with room for a 1MB cart plus the tooling scratch costs 0.3ms and emulates identically.",
	"video": {
		"width": 256,
		"height": 240,
		"virtualWidth": 293,
		"virtualHeight": 240,
		"vsyncNumerator": 39375000,
		"vsyncDenominator": 655171,
		"getBgra": "GetVideoBgra"
	},
	"audio": {
		"samplesPerFrame": 735,
		"channels": 1,
		"get": "GetAudio"
	},
	"input": {
		"name": "NES Controller",
		"buttons": [
			"P1 A", "P1 B", "P1 Select", "P1 Start", "P1 Up", "P1 Down", "P1 Left", "P1 Right",
			"P2 A", "P2 B", "P2 Select", "P2 Start", "P2 Up", "P2 Down", "P2 Left", "P2 Right",
			"P3 A", "P3 B", "P3 Select", "P3 Start", "P3 Up", "P3 Down", "P3 Left", "P3 Right",
			"P4 A", "P4 B", "P4 Select", "P4 Start", "P4 Up", "P4 Down", "P4 Left", "P4 Right",
			"P2 Fire", "P3 Fire"
		],
		"mnemonics": {
			"A": "A", "B": "B", "Select": "s", "Start": "S", "Up": "U", "Down": "D", "Left": "L", "Right": "R",
			"Fire": "F"
		},
		"axes": [
			{ "name": "P2 Paddle", "min": 0, "max": 160, "neutral": 80, "header": "Pad" },
			{ "name": "P3 Paddle", "min": 0, "max": 160, "neutral": 80, "header": "Pad" }
		]
	},
	"lag": {
		"inputWasRead": "InputWasRead"
	},
	"extensions": {
		".nes": "NES"
	},
	"settings": [
		{
			"name": "port1",
			"display": "Left Port Peripheral",
			"description": "What is plugged into controller port 1. It is part of the machine, so changing it restarts the core.",
			"type": "enum",
			"options": [ "none", "gamepad", "fourScore", "arkanoidNES", "arkanoidFamicom" ],
			"default": "gamepad"
		},
		{
			"name": "port2",
			"display": "Right Port Peripheral",
			"description": "What is plugged into controller port 2. The Four Score here is the second half of a four-player adapter.",
			"type": "enum",
			"options": [ "none", "gamepad", "fourScore" ],
			"default": "none"
		},
		{
			"name": "spriteLimit",
			"display": "Visible Sprites",
			"description": "How many sprites are drawn on one line of the picture. 8 is what the console does, and it is why sprites flicker. 64 draws them all. It changes the picture only. The game runs the same, and the setting is not saved in movies.",
			"type": "int",
			"min": 0,
			"max": 64,
			"default": 8
		}
	]
}
