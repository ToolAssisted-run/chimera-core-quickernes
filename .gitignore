# Meson build trees: the guest cross file and both build dirs are machine-local
build/

run-clang-format

# Things
.vscode

# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# miniHawk adapter build outputs
minihawk/bin/
minihawk/obj/

# witness harness scratch (per-run configs, dumps, logs)
minihawk/tests/work/
waterbox/bin/
